# ═══════════════════════════════════════════════════════════════
# Let-S APK Builder — Backend Environment Variables
# Copy to `.env` locally:  cp .env.example .env
# For Render: paste each key=value in Dashboard → Environment
# ═══════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────
# Render dynamically injects PORT (default 10000). Leave as-is for local.
PORT=10000
NODE_ENV=development
# Public URL of THIS backend (used to build webhook callback URL).
# Local: http://localhost:10000
# Render: https://lets-apk-builder.onrender.com
PUBLIC_URL=http://localhost:10000

# Comma-separated list of allowed frontend origins (no trailing slash).
# Local dev + your GitHub Pages URL.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://letssecuredo.github.io

# ─── GitHub (trigger Actions workflow) ──────────────────────────
# Fine-grained PAT with "Actions: Read and write" on the target repo only.
# Create: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=github_pat_REPLACE_WITH_YOUR_FINE_GRAINED_TOKEN

# owner/repo that contains .github/workflows/build-apk.yml
GITHUB_REPO=letssecuredo/lets-apk-builder

# Workflow filename (must exist at .github/workflows/<file>)
GITHUB_WORKFLOW_FILE=build-apk.yml

# Branch/ref to run the workflow from
GITHUB_REF=main

# ─── Firebase Admin SDK (Firestore + Storage) ───────────────────
# Get these from: Firebase Console → Project Settings → Service Accounts
# → Generate new private key (JSON) → copy fields below.
FIREBASE_PROJECT_ID=lets-apk-builder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lets-apk-builder.iam.gserviceaccount.com

# NOTE: Keep the literal \n sequences. Do NOT convert to real newlines.
# Wrap the whole value in double quotes exactly like this:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...REPLACE_ME...\n-----END PRIVATE KEY-----\n"

# Storage bucket (usually <project-id>.appspot.com)
FIREBASE_STORAGE_BUCKET=lets-apk-builder.appspot.com

# ─── Webhook security (HMAC-SHA256) ─────────────────────────────
# MUST match the WEBHOOK_SECRET GitHub repo secret in the worker repo.
# Generate with:  openssl rand -hex 64
WEBHOOK_SECRET=REPLACE_WITH_128_HEX_CHARS

# ─── Rate limiting ──────────────────────────────────────────────
# Builds per hour per IP
RATE_LIMIT_BUILD_MAX=5
# Any /api requests per 15 min per IP
RATE_LIMIT_API_MAX=100

# ─── Optional JWT auth (leave disabled unless you need it) ──────
JWT_ENABLED=false
# Generate with:  openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ─── Logging ────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
